rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // المدير: نفس الإيميل + إيميل مؤكد (يمنع انتحال الإيميل)
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'khalidchaf200@gmail.com';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // إنشاء الحساب: رصيد تجريبي = 2 دقيقة فقط
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.balance == 2
        && request.resource.data.unlimited == false
        && request.resource.data.email == request.auth.token.email.lower();

      // المستخدم يستطيع فقط إنقاص رصيده. الزيادة للمدير فقط.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'minutesUsed', 'updatedAt'])
            && request.resource.data.balance < resource.data.balance
            && request.resource.data.balance >= 0);

      allow delete: if false;
    }

    // طلبات شحن الرصيد
    match /topups/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= 1
        && request.resource.data.minutes <= 10000;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
